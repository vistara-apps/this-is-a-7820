# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI Configuration
VITE_OPENAI_API_KEY=your_openai_api_key

# Stripe Configuration (if using Stripe instead of Web3 payments)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# App Configuration
VITE_APP_NAME=KnowYourRights
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Analytics (optional)
VITE_ANALYTICS_ID=your_analytics_id

# Geolocation API (optional - for reverse geocoding)
VITE_GEOCODING_API_KEY=your_geocoding_api_key

# Emergency Services API (optional)
VITE_EMERGENCY_SERVICES_API_KEY=your_emergency_services_api_key
